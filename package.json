{
  "name": "mw4-camo-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CamoField: a source-aware Modern Warfare 4 camo tracker on Cloudflare Workers.",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 4321",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0 --port 4321",
    "test": "tsx --test tests/*.test.ts",
    "test:smoke": "node scripts/smoke.mjs",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply mw4-camo-tracker-db --local",
    "db:remote": "wrangler d1 migrations apply mw4-camo-tracker-db --remote",
    "data:check": "tsx scripts/check-data.ts",
    "format": "prettier --write src tests scripts docs README.md package.json vite.config.ts",
    "og": "node scripts/og.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "better-auth": "1.7.25",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.69.1",
    "@cloudflare/workers-types": "5.20261115.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "^4.20.6",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "wrangler": "4.162.0"
  }
}
